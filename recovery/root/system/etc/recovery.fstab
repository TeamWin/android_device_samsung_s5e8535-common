#<src>                                    <mnt_point>    <type>    <mnt_flags and options>    <fs_mgr_flags>

# Logical SYSTEM - RO2RW + Erasable (TWRP mountable/writable)
system         /system     ext4    defaults    avb=vbmeta,logical,first_stage_mount,formattable
system         /system     f2fs    defaults    avb=vbmeta,logical,first_stage_mount,formattable
system         /system     erofs   ro          avb=vbmeta,logical,first_stage_mount

# Other logical partitions (keep ro for safety)
vendor         /vendor     erofs   ro          avb,logical,first_stage_mount
vendor         /vendor     f2fs    ro          avb,logical,first_stage_mount
vendor         /vendor     ext4    ro          avb,logical,first_stage_mount
product        /product    erofs   ro          avb,logical,first_stage_mount
odm            /odm        erofs   ro          avb,logical,first_stage_mount
system_dlkm    /system_dlkm erofs  ro          wait,avb,logical,first_stage_mount
system_dlkm    /system_dlkm f2fs   ro          wait,avb,logical,first_stage_mount
system_dlkm    /system_dlkm ext4   ro          wait,avb,logical,first_stage_mount
vendor_dlkm    /vendor_dlkm erofs  ro          wait,avb,logical,first_stage_mount

# Physical partitions
/dev/block/by-name/boot         /boot           emmc    defaults    recoveryonly
/dev/block/by-name/recovery     /recovery       emmc    defaults    recoveryonly
/dev/block/by-name/metadata     /metadata       ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic,sync    wait,first_stage_mount,formattable,check
/dev/block/by-name/userdata     /data           f2fs    noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678    recoveryonly,length=-20480,fscompress
/dev/block/by-name/cache        /cache          ext4    defaults    recoveryonly
/dev/block/by-name/sec_efs      /efs            ext4    defaults    recoveryonly
/dev/block/by-name/sec_efs      /sec_efs        ext4    defaults    recoveryonly
/dev/block/by-name/radio        /modem          emmc    defaults    recoveryonly
/dev/block/by-name/dtbo         /dtbo           emmc    defaults    recoveryonly
/dev/block/by-name/prism        /prism          ext4    defaults    recoveryonly
/dev/block/by-name/optics       /optics         ext4    defaults    recoveryonly
/dev/block/by-name/vbmeta_system /vbmeta_system  emmc    defaults    recoveryonly
/dev/block/by-name/vendor_boot  /vendor_boot    emmc    defaults    recoveryonly
/dev/block/by-name/vbmeta_samsung /vbmeta_samsung emmc defaults    recoveryonly
/dev/block/by-name/init_boot    /init_boot      emmc    defaults    recoveryonly

# Misc partitions
/dev/block/by-name/misc        /misc           emmc    defaults    recoveryonly
/dev/block/mmcblk0p1           /sdcard         vfat    defaults    recoveryonly
